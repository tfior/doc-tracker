-include .env
export

.PHONY: dev migrate seed create-user test schema backend frontend

dev:
	docker compose -f docker-compose.yml -f docker-compose.dev.yml up db

backend:
	cd backend && go run ./cmd/server

frontend:
	cd frontend && npm run dev

migrate:
	migrate -path backend/db/migrations -database "postgres://$(DB_USER):$(DB_PASSWORD)@$(DB_HOST):$(DB_PORT)/$(DB_NAME)?sslmode=disable" up

seed:
	cd backend && go run ./cmd/seed

create-user:
	cd backend && go run ./cmd/create-user

test: ## requires 'make dev' (postgres) to be running
	cd backend && go test -count=1 -p 1 ./...

# pg_dump must match the server's major version, so it runs from the same image.
SCHEMA_DB_NAME ?= doctracker_schema
PG_DUMP ?= docker run --rm --network host -e PGPASSWORD postgres:18-alpine pg_dump

schema: ## requires 'make dev' (postgres) to be running
	cd backend && SCHEMA_DB_NAME=$(SCHEMA_DB_NAME) go run ./cmd/schema-db
	PGPASSWORD="$$DB_PASSWORD" $(PG_DUMP) --schema-only --no-owner --no-privileges \
		--exclude-table=schema_migrations \
		-h $(DB_HOST) -p $(DB_PORT) -U $(DB_USER) $(SCHEMA_DB_NAME) > backend/db/schema.sql.tmp
	{ echo '-- Generated by `make schema` from db/migrations. Do not edit by hand.'; \
	  grep -v -e '^-- Dumped from' -e '^-- Dumped by' -e '^\\restrict ' -e '^\\unrestrict ' backend/db/schema.sql.tmp; \
	} > backend/db/schema.sql
	rm backend/db/schema.sql.tmp
